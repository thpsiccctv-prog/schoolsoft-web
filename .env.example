# Copy this file to ".env" for local desktop/dev overrides.
# On Render, set these as real environment variables in the service's
# "Environment" tab instead of uploading a .env file.

# Generate a fresh one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SCHOOLSOFT_SECRET_KEY=change-me-to-a-long-random-value

# Leave unset (or True) for local/.exe use. Set to False for the online deployment.
SCHOOLSOFT_DEBUG=True

# Comma separated list of hostnames allowed to serve this app.
SCHOOLSOFT_ALLOWED_HOSTS=127.0.0.1,localhost,english-medium.thpsic.com

# Comma separated list of https:// origins allowed to POST (forms/admin) to this app.
SCHOOLSOFT_CSRF_TRUSTED_ORIGINS=https://english-medium.thpsic.com

# Production HTTPS/security options. Keep these defaults for Render/custom domain.
SCHOOLSOFT_SECURE_SSL_REDIRECT=True
SCHOOLSOFT_SECURE_HSTS_SECONDS=3600

# Enable only after confirming every subdomain is HTTPS-only and you intentionally
# want browser preload behavior for the domain.
SCHOOLSOFT_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SCHOOLSOFT_SECURE_HSTS_PRELOAD=False

# Set automatically by Render for its managed PostgreSQL "Internal Database URL".
# Leave unset locally to keep using SQLite (db.sqlite3).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
